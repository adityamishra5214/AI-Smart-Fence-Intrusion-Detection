# PIDS Environment Configuration

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
NODE_TTL_SECONDS=3

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pids_db
# Fallback local SQLite URL:
# DATABASE_URL=sqlite+aiosqlite:///./pids.db

# Ingestion Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Edge ML Classifier Path
MODEL_PATH=ml/model.joblib

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL=http://localhost:8000

